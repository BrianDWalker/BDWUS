{
  "routes": [
    {
      "route": "/*",
      "serve": "/index.html",
      "statusCode": 200
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/images/*", "/css/*", "/js/*", "/assets/*"]
  },
  "misecsToWaitBeforeDeletingUploadedFiles": 3600000,
  "build": {
    "appLocation": "web-ui",
    "outputLocation": "web-ui/dist",
    "appBuildCommand": "npm run build",
    "appDevserverUrl": "http://localhost:5173"
  }
}
